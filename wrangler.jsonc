{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sigma-code-website",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "routes": [
    {
      "pattern": "sigmacode.biz",
      "custom_domain": true
    },
    {
      "pattern": "www.sigmacode.biz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
